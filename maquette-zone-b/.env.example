###############################################################################
# Template variables d'environnement — SL1PCONNECT Zone B IoT
# COPIER en .env.prod ou .env.dev — NE JAMAIS COMMITER le fichier .env
###############################################################################

# Environnement (prod | dev | staging)
ENV=prod

# Registry Harbor
REGISTRY=harbor.slipconnect.com

# Tag de l'image (géré automatiquement par CI, sinon : latest)
TAG=latest

# Base de données (le mot de passe est dans secrets/db_password.txt)
DB_NAME=slipconnect_iot

# Grafana
GRAFANA_USER=admin

# Variables CI (remplies par le pipeline)
# HARBOR_USER=
# HARBOR_PASSWORD=
# DEPLOY_SSH_KEY=
# PROD_HOST=
# SLACK_WEBHOOK=
